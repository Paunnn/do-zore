{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "do-zore",
    "Audience": "do-zore-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Writes": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Analytics": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "GameData": {
    "MinClientVersion": "0.1.0"
  },
  "Leaderboard": {
    "MaxScorePerSecond": 5000
  },
  "DisplayNames": {
    "Blocked": [ "admin", "moderator", "dozore", "support" ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
