# Server configuration — copy to .env and fill in real values. Never commit .env.

# Database connection string
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=dozore;Username=CHANGE_ME;Password=CHANGE_ME

# JWT signing secret (use a long random value, at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Port the server listens on
PORT=5000
